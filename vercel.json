{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 build.py",
  "outputDirectory": "dist",
  "installCommand": "",
  "trailingSlash": true,
  "redirects": [
    { "source": "/pharmacy/bodypower-pharmacy-partners.pdf", "destination": "/assets/docs/bodypower-pharmacy-partners.pdf", "statusCode": 301 },
    { "source": "/pharmacy", "destination": "/partner/?category=pharmacy", "statusCode": 301 },
    { "source": "/pharmacy/", "destination": "/partner/?category=pharmacy", "statusCode": 301 },
    { "source": "/workshops", "destination": "/games/#education", "statusCode": 301 },
    { "source": "/workshops/", "destination": "/games/#education", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(img|docs)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(favicon.svg|robots.txt|sitemap.xml)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
